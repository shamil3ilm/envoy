{
  "name": "envoy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Envoy",
  "author": "Mohamed Shamil",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:mobile:android": "npm run build:android --workspace=apps/mobile",
    "build:mobile:ios": "npm run build:ios --workspace=apps/mobile",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "turbo run typecheck test"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "packageManager": "npm@10.0.0"
}
