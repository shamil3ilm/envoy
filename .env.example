# Envoy environment variables
#
# Copy this to .env (or set in your shell) to configure Envoy.
# NEVER commit the resulting .env — it is in .gitignore.

# ---------- Desktop app runtime ----------

# Database backend: 'sqlite' (default, local file) or 'mysql'
DB_TYPE=sqlite

# MySQL only — ignored when DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=envoy

# ---------- Crash telemetry (opt-in) ----------
# Sentry activates only when the DSN is set. beforeSend redacts any key
# matching /password|token|secret|apiKey|api_key/i before send.

# ENVOY_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY   # desktop main
# VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY    # desktop renderer
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY         # mobile

# ---------- Release signing (electron-builder reads these) ----------
# See DEPLOYMENT.md for how to obtain each cert/token.

# Windows Authenticode signing
# WIN_CSC_LINK=./certs/win.pfx
# WIN_CSC_KEY_PASSWORD=

# macOS Developer ID signing + notarization
# CSC_LINK=./certs/mac.p12
# CSC_KEY_PASSWORD=
# APPLE_ID=you@example.com
# APPLE_ID_PASSWORD=app-specific-password
# APPLE_TEAM_ID=ABCDE12345

# GitHub token used by electron-updater's publish target (needs `repo` scope)
# GH_TOKEN=ghp_xxx

# ---------- Mobile release ----------
# Set to 'true' to let ./gradlew assembleRelease sign with the debug keystore
# — LOCAL TESTING ONLY. Never enable for a Play Store upload build.
# ENVOY_ALLOW_UNSIGNED_RELEASE=false
