{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"],
      "@envoy/shared": ["../../packages/shared/src"],
      "@envoy/database-core": ["../../packages/database-core/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.js", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
