{
  "name": "@envoy/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Envoy Desktop App",
  "author": "Mohamed Shamil",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "node scripts/launch-electron.js",
    "electron": "npm run build:main && npm run start",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/msal-node": "^5.0.3",
    "@envoy/database-core": "*",
    "@envoy/shared": "*",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@sentry/electron": "^5.12.0",
    "@tiptap/extension-color": "^3.31.2",
    "@tiptap/extension-font-family": "^3.31.2",
    "@tiptap/extension-highlight": "^3.31.2",
    "@tiptap/extension-image": "^3.31.2",
    "@tiptap/extension-placeholder": "^3.31.2",
    "@tiptap/extension-table": "^3.31.2",
    "@tiptap/extension-table-cell": "^3.31.2",
    "@tiptap/extension-table-header": "^3.31.2",
    "@tiptap/extension-table-row": "^3.31.2",
    "@tiptap/extension-text-align": "^3.31.2",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-underline": "^3.31.2",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^11.10.0",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "googleapis": "^130.0.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^6.9.9",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.16",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.9.1",
    "lucide-react": "^0.323.0",
    "postcss": "^8.5.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.1",
    "vitest": "^2.1.9",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.envoy.app",
    "productName": "Envoy",
    "icon": "resources/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "engine/**/*"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "envoy-app",
        "repo": "envoy",
        "releaseType": "release"
      }
    ]
  }
}
